@page "/dashboard"

<PageTitle>StaffSphere Dashboard</PageTitle>

<div class="container-fluid p-4">

    <h1>StaffSphere</h1>
    <p>Employee Management System</p>

    <div class="row g-3 mt-3">

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Total Employees</h5>
                <h2>120</h2>
                <p>All employees</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Active Employees</h5>
                <h2>105</h2>
                <p>Currently working</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Departments</h5>
                <h2>8</h2>
                <p>Total departments</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>On Leave</h5>
                <h2>15</h2>
                <p>Employees on leave</p>
            </div>
        </div>

    </div>

    <div class="card shadow p-4 mt-4">

        <h3>Recent Employees</h3>

        <table class="table table-striped mt-3">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>101</td>
                    <td>Rahul Sharma</td>
                    <td>IT</td>
                    <td>Developer</td>
                    <td>Active</td>
                </tr>

                <tr>
                    <td>102</td>
                    <td>Priya Singh</td>
                    <td>HR</td>
                    <td>Manager</td>
                    <td>Active</td>
                </tr>

                <tr>
                    <td>103</td>
                    <td>Amit Kumar</td>
                    <td>Finance</td>
                    <td>Accountant</td>
                    <td>Active</td>
                </tr>
            </tbody>

        </table>
    </div>

</div>

